# Render + Supabase (free-tier friendly)
# Keep the Supabase secret key ONLY in Render environment variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=boyz-data
SUPABASE_MEDIA_BUCKET=boyz-media

# Cloudflare R2 image storage (recommended for photos/media; leave blank until configured)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=boyz-of-rosario-media
R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_R2_DOMAIN

# Boyz of Rosario application settings
ADMIN_EMAIL=admin@boyzofrosario.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_NAME=Primary Administrator
ADMIN_REGISTRATION_CODE=CHANGE_THIS_CODE
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
MAP_LAT=13.8454
MAP_LNG=121.2060
PORT=10000
